table Calendar
	lineageTag: 3d9b2710-46e4-44ed-6f46-5a4cce09ae43
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: e7347626-3498-9f2f-4070-db4c9e776da1
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Month number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 417ab3ca-8ab6-063c-eb23-7e3fd437bfce
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 0a5dfc42-d9d5-e36f-e6eb-c299325bcb30
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: 'Month number'

		annotation SummarizationSetBy = Automatic

	column iso_dow
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 233ffa67-5244-af7c-9e84-a789a9e6ec4d
		summarizeBy: none
		sourceColumn: iso_dow

		annotation SummarizationSetBy = Automatic

	column Weekday
		dataType: string
		lineageTag: 62b90a3a-b938-666d-5a9d-3cc82ed5085d
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: iso_dow

		annotation SummarizationSetBy = Automatic

	column 'Day type'
		dataType: string
		lineageTag: 207a44b5-f575-fefa-ad1d-b6edd6751128
		summarizeBy: none
		sourceColumn: day_type

		annotation SummarizationSetBy = Automatic

	column Season
		dataType: string
		lineageTag: 9db1a7f3-be3d-4ada-de2c-90d76b214ff3
		summarizeBy: none
		sourceColumn: season

		annotation SummarizationSetBy = Automatic

	partition Calendar = m
		mode: import
		source =
				let
				    Archivo = "dim_date.csv",
				    Binario = if Text.StartsWith(DataPath, "http")
				        then Web.Contents(DataPath, [RelativePath = Archivo])
				        else File.Contents(DataPath & Archivo),
				    Fuente = Csv.Document(Binario, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Fuente, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"date", type date}, {"month", Int64.Type}, {"month_name", type text}, {"iso_dow", Int64.Type}, {"day_name", type text}, {"day_type", type text}, {"season", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
